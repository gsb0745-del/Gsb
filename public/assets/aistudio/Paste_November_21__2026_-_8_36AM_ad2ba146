<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GS Calendar 2027 - जी.एस. कैलेंडर २०२७ (कालदर्शक पंचांग)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;600;700;900&family=Poppins:wght@400;500;600;700;800&family=Rozha+One&display=swap" rel="stylesheet">
    <style>
        :root {
            --paper-bg: #FCF8EE;
            --paper-border: #8B1E1E;
            --crimson: #B91C1C;
            --saffron: #D97706;
            --royal-blue: #1E3A8A;
        }

        body {
            font-family: 'Noto Serif Devanagari', 'Poppins', serif;
            background-color: #2c221e;
            background-image: radial-gradient(#42332d 1px, transparent 1px);
            background-size: 20px 20px;
            color: #1f1916;
        }

        .font-display {
            font-family: 'Rozha One', 'Noto Serif Devanagari', serif;
        }

        .font-eng {
            font-family: 'Poppins', sans-serif;
        }

        /* Realistic Wall Calendar Paper Texture */
        .calendar-sheet {
            background-color: var(--paper-bg);
            background-image: 
                linear-gradient(to right, rgba(217, 119, 6, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(217, 119, 6, 0.04) 1px, transparent 1px),
                radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.8), rgba(244, 234, 213, 0.6));
            background-size: 24px 24px, 24px 24px, 100% 100%;
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.5),
                0 4px 12px rgba(0, 0, 0, 0.3),
                inset 0 0 40px rgba(185, 28, 28, 0.06);
            position: relative;
            overflow: hidden;
        }

        /* Diagonal GS Watermark on every sheet */
        .gs-watermark {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .gs-watermark-inner {
            transform: rotate(-32deg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0.065;
            user-select: none;
        }

        /* Page Turn Animation */
        @keyframes pageFlipIn {
            0% {
                opacity: 0.3;
                transform: perspective(1200px) rotateX(-8deg) translateY(-10px);
            }
            100% {
                opacity: 1;
                transform: perspective(1200px) rotateX(0deg) translateY(0);
            }
        }

        .page-animate {
            animation: pageFlipIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Traditional Ornamental Border */
        .kaldarshak-border {
            border: 3px solid #991B1B;
            outline: 2px solid #D97706;
            outline-offset: -6px;
        }

        /* Calendar Grid Cell Hover & Active */
        .date-cell {
            transition: all 0.18s ease;
            background: rgba(255, 253, 248, 0.75);
        }

        .date-cell:hover {
            background: #FEF3C7;
            transform: scale(1.015);
            z-index: 15;
            box-shadow: 0 4px 12px rgba(185, 28, 28, 0.18);
        }

        .sunday-cell {
            background: rgba(254, 226, 226, 0.55);
        }

        .holiday-cell {
            background: linear-gradient(135deg, rgba(254, 226, 226, 0.75) 0%, rgba(254, 243, 199, 0.75) 100%);
        }

        /* Custom Scrollbar for Rashifal & Panchang Sidebar */
        .panchang-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .panchang-scroll::-webkit-scrollbar-track {
            background: #F5EBD6;
            border-radius: 8px;
        }
        .panchang-scroll::-webkit-scrollbar-thumb {
            background: #B91C1C;
            border-radius: 8px;
        }

        /* Hanging Hole & Spiral Ring Visual at Top */
        .calendar-hanger {
            background: linear-gradient(180deg, #991B1B 0%, #7F1D1D 100%);
            border-bottom: 4px solid #F59E0B;
        }

        @media print {
            body {
                background: white !important;
                padding: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .calendar-sheet {
                box-shadow: none !important;
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 !important;
            }
        }
    </style>
</head>
