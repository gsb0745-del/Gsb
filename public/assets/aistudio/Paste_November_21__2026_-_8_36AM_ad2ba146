        // Helper: Convert English digits to Devanagari digits
        function toDevanagariDigits(num) {
            const devDigits = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
            return String(num).replace(/\d/g, d => devDigits[d]);
        }

        // Helper: Get Religion Badge Colors
        function getReligionBadgeStyle(type, isGovt) {
            if (isGovt && type === "govt") {
                return { bg: "bg-red-700 text-white", icon: "🏛️", label: "राजकीय अवकाश" };
            }
            switch (type) {
                case "hindu":
