                        }">
                            ${dayNum}
                        </span>
                        ${p.isGovtHoliday ? `<span class="text-[9px] sm:text-[10px] font-extrabold bg-red-700 text-white px-1.5 py-0.5 rounded shadow-xs">अवकाश</span>` : ""}
                    </div>
                `;

                // Bottom Row: Festival labels or Nakshatra/Special Tithi
                let bottomContent = "";
                if (visibleFestivals.length > 0) {
                    bottomContent = visibleFestivals.slice(0, 2).map(f => {
                        const badge = getReligionBadgeStyle(f.type, f.isGovt);
