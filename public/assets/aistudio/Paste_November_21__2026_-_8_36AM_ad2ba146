        document.querySelectorAll(".filter-pill").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".filter-pill").forEach(b => {
                    b.classList.remove("bg-amber-500", "text-stone-950", "font-bold");
                    b.classList.add("bg-stone-800", "font-semibold");
                });
                btn.classList.remove("bg-stone-800", "font-semibold");
                btn.classList.add("bg-amber-500", "text-stone-950", "font-bold");

                activeFilter = btn.getAttribute("data-filter");
                renderCalendar(currentMonth);
            });
        });

        // Modal Close Handlers
        document.getElementById("closeModalBtn").addEventListener("click", closeDayModal);
        document.getElementById("modalOkBtn").addEventListener("click", closeDayModal);
        document.getElementById("dayModal").addEventListener("click", (e) => {
            if (e.target.id === "dayModal") closeDayModal();
        });

        // Keyboard Left/Right Arrow Navigation
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeDayModal();
            if (e.key === "ArrowLeft") {
                currentMonth = (currentMonth - 1 + 12) % 12;
                renderCalendar(currentMonth);
            } else if (e.key === "ArrowRight") {
                currentMonth = (currentMonth + 1) % 12;
                renderCalendar(currentMonth);
