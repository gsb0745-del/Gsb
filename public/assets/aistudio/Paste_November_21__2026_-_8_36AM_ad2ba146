                } else if (p.tithiInfo.special) {
                    bottomContent = `
                        <div class="text-[9.5px] sm:text-[10px] font-semibold text-amber-900 truncate">
                            • ${p.tithiInfo.special}
                        </div>
                    `;
                } else {
                    bottomContent = `
                        <div class="text-[9.5px] sm:text-[10px] text-stone-500 font-medium truncate">
                            ${p.nakshatra}
                        </div>
                    `;
                }

                cell.innerHTML = `${topRow}${middleRow}<div class="space-y-0.5">${bottomContent}</div>`;
                cell.addEventListener("click", () => openDayModal(p));
                calendarGrid.appendChild(cell);
            }

            // Render Bottom Monthly Festivals & Govt Holidays List
            renderMonthlyFestivalsList(monthIdx, mData);

            // Render Right Sidebar Jyotish Ganana
            renderJyotishBox(mData);

            // Render Right Sidebar Monthly Rashifal
            renderRashifalBox(mData);
        }

