                case "other":
                    return { bg: "bg-blue-100 text-blue-950 border border-blue-400", icon: "✨", label: "सर्वधर्म" };
                default:
                    return { bg: "bg-red-100 text-red-950 border border-red-400", icon: "🏛️", label: "अवकाश" };
            }
        }

        // Compute detailed Panchang for a specific day in 2027
        function getDayPanchang(monthIdx, dayNum) {
            const mData = CALENDAR_2027[monthIdx];
            const dateObj = new Date(2027, monthIdx, dayNum);
            const weekdayIdx = dateObj.getDay();

            // Lunar Tithi calculation (advances ~1.015 tithis per solar day for natural alignment)
            const tithiOffset = Math.floor((dayNum - 1) * 1.015);
            const tithiIdx = (mData.startTithiIndex + tithiOffset) % 30;
            const tithiInfo = TITHI_CYCLE[tithiIdx];
            const lunarMasa = dayNum <= mData.monthSwitchDay ? mData.lunarMonth1 : mData.lunarMonth2;

            // Vikram Samvat Year transition on April 7, 2027
            let vsYear = "२०८३";
            if (monthIdx > 3 || (monthIdx === 3 && dayNum >= 7)) {
                vsYear = "२०८४";
            }

            // Hijri Date calculation
            let hijriDay = mData.hijriStartDay + (dayNum - 1);
            let hijriMonth = mData.hijriM1;
            if (hijriDay > mData.hijriDaysInM1) {
                hijriDay = hijriDay - mData.hijriDaysInM1;
                hijriMonth = mData.hijriM2;
            }

            // Hijri Year transition on July 6, 2027 (Muharram 1)
            let hijriYearNum = "१४४८";
            if (monthIdx > 6 || (monthIdx === 6 && dayNum >= 6)) {
                hijriYearNum = "१४४९";
            }

            // Nakshatra & Yoga deterministic cycle across year
            const dayOfYear = Math.floor((dateObj - new Date(2027, 0, 1)) / (1000 * 60 * 60 * 24));
            const nakshatra = NAKSHATRAS[(dayOfYear + 8) % NAKSHATRAS.length];
            const yoga = YOGAS[(dayOfYear + 14) % YOGAS.length];

            // Matching festivals on this day
            const dayFestivals = mData.festivals.filter(f => f.day === dayNum);
            const isGovtHoliday = dayFestivals.some(f => f.isGovt);

            return {
                dayNum,
                monthIdx,
                weekdayIdx,
                weekdayName: WEEKDAYS_HI[weekdayIdx],
                tithiIdx,
                tithiInfo,
                lunarMasa,
                vsYear,
                hijriDay,
                hijriMonth,
                hijriYearNum,
                nakshatra,
                yoga,
                rahukaal: RAHUKAAL_BY_DAY[weekdayIdx],
                sunrise: mData.sunrise,
                sunset: mData.sunset,
                dayFestivals,
                isGovtHoliday
            };
        }

        // Main Render Function
        function renderCalendar(monthIdx) {
            const mData = CALENDAR_2027[monthIdx];

            // Trigger subtle page animation
            calendarSheet.classList.remove("page-animate");
            void calendarSheet.offsetWidth;
            calendarSheet.classList.add("page-animate");

            // Update Select & Headers
            monthSelect.value = monthIdx;
            document.getElementById("monthNumberBadge").textContent = toDevanagariDigits(String(monthIdx + 1).padStart(2, "0"));
            document.getElementById("currentMonthHindi").textContent = `${HINDI_MONTHS_NAME[monthIdx]} २०२७`;
            document.getElementById("currentMonthEng").textContent = `${HINDI_MONTHS_ENG[monthIdx]} 2027`;
            document.getElementById("vikramSamvatHeader").textContent = mData.vikramSamvat;
            document.getElementById("shakaSamvatHeader").textContent = mData.shakaSamvat;
            document.getElementById("hijriYearHeader").textContent = mData.hijriYear;
            document.getElementById("hijriMonthsHeader").textContent = mData.hijriMonths;
            document.getElementById("hindiMasaBadge").textContent = `${mData.hindiMasa} (${mData.vikramSamvat})`;
            document.getElementById("rituBadge").textContent = mData.ritu;
            document.getElementById("rashifalMonthSubtitle").textContent = `${HINDI_MONTHS_NAME[monthIdx]} 2027 — सभी १२ राशियों का फल`;

            // Calculate Grid Geometry
            const firstDayOfWeek = new Date(2027, monthIdx, 1).getDay(); // 0=Sun..6=Sat
            const totalDaysInMonth = new Date(2027, monthIdx + 1, 0).getDate();
            const totalCells = Math.ceil((firstDayOfWeek + totalDaysInMonth) / 7) * 7;

            calendarGrid.innerHTML = "";

            for (let cellIdx = 0; cellIdx < totalCells; cellIdx++) {
                const dayNum = cellIdx - firstDayOfWeek + 1;

                // Empty leading/trailing decorative cell
                if (dayNum < 1 || dayNum > totalDaysInMonth) {
                    const emptyCell = document.createElement("div");
                    emptyCell.className = "min-h-[96px] sm:min-h-[115px] bg-amber-950/5 p-1.5 flex items-center justify-center";
                    emptyCell.innerHTML = `<span class="text-amber-800/20 text-lg select-none">卐</span>`;
                    calendarGrid.appendChild(emptyCell);
                    continue;
                }

                const p = getDayPanchang(monthIdx, dayNum);
                const isSunday = p.weekdayIdx === 0;
                const isRedDay = isSunday || p.isGovtHoliday;

                // Filter festival display based on activeFilter
                const visibleFestivals = p.dayFestivals.filter(f => {
                    if (activeFilter === "all") return true;
                    if (activeFilter === "govt") return f.isGovt;
                    return f.type === activeFilter;
                });

                // Moon Phase Icon for Purnima (14) & Amavasya (29)
                let moonBadge = "";
                if (p.tithiIdx === 14) {
                    moonBadge = `<span title="पूर्णिमा" class="w-3.5 h-3.5 rounded-full bg-amber-400 border border-amber-700 inline-block shadow-xs"></span>`;
                } else if (p.tithiIdx === 29) {
                    moonBadge = `<span title="अमावस्या" class="w-3.5 h-3.5 rounded-full bg-stone-900 border border-stone-600 inline-block shadow-xs"></span>`;
                }

                // Cell Container
                const cell = document.createElement("div");
                cell.className = `date-cell min-h-[98px] sm:min-h-[118px] p-1.5 sm:p-2 flex flex-col justify-between cursor-pointer relative ${
                    p.isGovtHoliday ? "holiday-cell" : isSunday ? "sunday-cell" : ""
                }`;

                // Top Row: Vikram Tithi + Moon Icon & Hijri Date
                const topRow = `
                    <div class="flex items-start justify-between gap-1 text-[10px] sm:text-[11px] leading-tight">
                        <span class="font-bold text-stone-700 truncate" title="${p.lunarMasa} ${p.tithiInfo.paksha} ${p.tithiInfo.name}">
                            ${p.tithiInfo.short}
                        </span>
                        <div class="flex items-center gap-1 shrink-0">
                            ${moonBadge}
                            <span class="font-bold text-emerald-800 bg-emerald-50/90 px-1 rounded border border-emerald-300/60" title="हिजरी: ${p.hijriDay} ${p.hijriMonth}">
                                ${toDevanagariDigits(p.hijriDay)} हि.
                            </span>
                        </div>
                    </div>
